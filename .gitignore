# 의존성
node_modules/

# 빌드 중간물 — build.mjs 가 만드는 build/<id>.zip, fetch-runtime.mjs 가 받는 build/vendor/
# (배포물 dist/*.zip 과 catalog.json 은 올린다 — 앱이 이 저장소에서 바로 받아 간다)
build/

# 테스트 · 로그
coverage/
*.log

# 비밀 값 — 플러그인 테스트용 DB · 서버 접속 정보 등
.env
.env.*

# OS · 편집기
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Claude Code — 팀 규칙 · 훅 · 스킬 · 설정만 올리고 나머지(개인 설정 · worktree · 커밋 심사 상태)는 무시
.claude/*
!.claude/rules/
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
# 개인 AI 도구 작업 폴더
.omc/

# GitHub Pages(docs/) 를 로컬에서 Jekyll 로 미리 볼 때 생기는 것
docs/_site/
docs/.jekyll-cache/
